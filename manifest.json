{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",

  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://play.autodarts.io/*",
    "https://api.autodarts.io/*",
    "https://play.autodarts.com/*",
    "https://api.autodarts.com/*",
    "https://api.github.com/*",
    "http://localhost:3180/*",
    "http://127.0.0.1:3180/*"
  ],

  "background": {
    "service_worker": "src/core/background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icon/16.png",
      "48":  "icon/48.png",
      "128": "icon/128.png"
    }
  },

  "icons": {
    "16":  "icon/16.png",
    "48":  "icon/48.png",
    "128": "icon/128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://play.autodarts.io/*",
        "https://play.autodarts.com/*"
      ],
      "js": ["src/core/pageScript.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://play.autodarts.io/*",
        "https://play.autodarts.com/*"
      ],
      "js": [
        "src/core/purify.js",
        "src/core/constants.js",
        "src/core/tokenHelper.js",
        "src/core/state.js",
        "src/ui/modals.js",
        "src/core/logic.js",
        "src/automation/sync.js",
        "src/ui/matchbox.js",
        "src/ui/views/bracket.js",
        "src/ui/tables.js",
        "src/ui/views/setup.js",
        "src/ui/views/league.js",
        "src/ui/views/groups.js",
        "src/automation/lobby.js",
        "src/core/actions.js",
        "src/ui/renderer.js",
        "content-scripts/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
